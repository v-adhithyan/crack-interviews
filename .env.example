# All values below are optional local-development overrides. Docker Compose has
# matching defaults, so `docker compose up --build` works without this file.
# For a public deployment, generate unique secrets with: openssl rand -hex 32
DJANGO_SECRET_KEY=local-development-secret-key-change-before-deploying
MYSQL_DATABASE=crack_interviews
MYSQL_USER=crack_interviews
MYSQL_PASSWORD=crack_interviews_local
MYSQL_ROOT_PASSWORD=crack_interviews_root_local

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
HACKERLEAP_CODE=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Keep manual mode unless OpenAI-backed features are needed. Never commit an API
# key; put it only in your ignored local `.env` or deployment secret manager.
HACKERLEAP_AI_MODE=manual
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_QUESTION_MAX_TOKENS=16000
